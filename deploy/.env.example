# Copy this file to deploy/.env and fill in real values there.
# deploy/.env is gitignored (see root .gitignore) -- never commit it.
# Every value below is a PLACEHOLDER. No real secret belongs in this file.

# ---------------------------------------------------------------------------
# Domain / TLS
# ---------------------------------------------------------------------------

# The domain Caddy requests a Let's Encrypt certificate for and serves the
# app on. Must already have an A record pointing at the Hetzner VPS
# (178.104.103.113) before `docker compose up -d`, or the ACME challenge
# fails. Used directly in deploy/Caddyfile as {$DOMAIN}.
DOMAIN=shop.example.com

# ---------------------------------------------------------------------------
# Postgres (deploy/docker-compose.yml `postgres` service)
# ---------------------------------------------------------------------------

# Chosen by you when first bringing the stack up; postgres:16-alpine creates
# this user/db on first boot of an empty `pgdata` volume.
POSTGRES_USER=dunyo
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=changeme-generate-with-openssl-rand-hex-24
POSTGRES_DB=dunyo

# Consumed by the `api` service (see api/src/lib/env.ts). Host is the
# compose service name `postgres`, port 5432 (Postgres's internal default,
# never published to the host -- see docker-compose.yml). Must reflect the
# same user/password/db as the three POSTGRES_* values above; docker
# compose does not interpolate one .env value into another, so keep these
# in sync by hand if you change them.
DATABASE_URL=postgres://dunyo:changeme-generate-with-openssl-rand-hex-24@postgres:5432/dunyo

# ---------------------------------------------------------------------------
# Telegram (api/src/lib/env.ts, deploy/Caddyfile via the webhook route)
# ---------------------------------------------------------------------------

# From @BotFather, `/newbot` (or `/token` for an existing bot). Never appears
# in web/ or any VITE_* build variable -- see docs/specs "Konfiguratsiya /
# Secrets".
TELEGRAM_BOT_TOKEN=

# Shared secret Telegram echoes back as `X-Telegram-Bot-Api-Secret-Token` on
# every webhook POST to /tg/webhook; the API rejects any request where it
# doesn't match. Generate with:
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=changeme-generate-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# API runtime (api/src/lib/env.ts)
# ---------------------------------------------------------------------------

# Public URL of the Mini App, used when validating Telegram initData and in
# messages the bot sends (e.g. deep links back into the app). Same value as
# https://$DOMAIN once TLS is live.
WEBAPP_URL=https://shop.example.com

# Directory the API reads/writes uploaded product images from. Must match
# the `media` volume's mount point in docker-compose.yml (`api` service)
# and the media root in deploy/Caddyfile (`/srv/dunyo/media`) -- Caddy
# serves files from the same path the API writes them to.
MEDIA_DIR=/srv/dunyo/media

# Port the Fastify process listens on inside the `api` container. Not
# published to the host; only reached by Caddy over the compose network.
PORT=3000

# How old a Telegram initData payload is allowed to be (seconds) before the
# API rejects it as expired. 86400 = 24 hours, matches api/src/lib/env.ts's
# default -- listed explicitly here so it's visible and tunable per deploy.
INIT_DATA_MAX_AGE_SEC=86400

# Comma-separated list of browser origins the API's CORS layer allows.
# Should just be WEBAPP_URL's origin in production (the Mini App is the
# only browser client); server-to-server calls and the Telegram webhook
# have no Origin header and are unaffected by this list.
ALLOWED_ORIGINS=https://shop.example.com

# ---------------------------------------------------------------------------
# Backups (deploy/backup.sh, `backup` service in docker-compose.yml)
# ---------------------------------------------------------------------------

# GPG key identifier (email, key ID, or fingerprint) backups are encrypted
# to. Only the PUBLIC key is imported on the server (see docs/deploy.md §9);
# the private key stays offline, so nobody who gets the server or the backup
# chat can decrypt a backup.
BACKUP_GPG_RECIPIENT=backup@example.com

# Telegram chat id of a PRIVATE group used ONLY for backups (not the shop
# order group; the bot must be a member). Encrypted dumps are sent here with
# sendDocument, and failure alerts too. Negative for groups.
BACKUP_TELEGRAM_CHAT_ID=-1001234567890

# OPTIONAL. Bot API base URL used for backup uploads. Default is the cloud
# Bot API (50 MB file limit). Point it at a local telegram-bot-api server
# (e.g. http://host.docker.internal:8081) for files up to 2 GB.
# TELEGRAM_API_BASE=https://api.telegram.org

# OPTIONAL. Extra copy of every backup on an rclone remote (e.g. a Hetzner
# Storage Box), with 14-day retention. Required only when a file is too big
# for Telegram (the weekly media archive, eventually).
# RCLONE_REMOTE=hetzner-storagebox:dunyo-backups
