# Public, client-side values only. NEVER put the bot token, DB credentials,
# or webhook secrets here or in any VITE_* variable — this file ships in the
# browser bundle.

VITE_API_URL=/api
VITE_MEDIA_URL=/media
VITE_BOT_USERNAME=your_bot
VITE_SUPPORT_USERNAME=your_support_username
VITE_CHANNEL_USERNAME=your_channel
VITE_MOCK=0
